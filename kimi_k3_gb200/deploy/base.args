# Recipe gb200/multi_node_tp command (recipes.vllm.ai/moonshotai/Kimi-K3/hw/gb200.json)
--trust-remote-code
# 0.90 (recipe: 0.95): the k3opt patches allocate after vLLM's memory profiling; at 0.95 a 14k-token
# prefill step OOMed (see STATUS.md). Decode speed is unaffected.
--gpu-memory-utilization
0.90
--tensor-parallel-size
16
--load-format
k3snap
--no-enable-flashinfer-autotune
--max-model-len
1048576
--kv-cache-dtype
fp8
--attention-config
{"use_prefill_query_quantization":true,"mla_prefill_backend":"TOKENSPEED_MLA"}
--enable-prefix-caching
--attention-backend
TOKENSPEED_MLA
--prefix-match-unit
128
--enable-auto-tool-choice
--tool-call-parser
kimi_k3
--reasoning-parser
kimi_k3
# Iteration settings: only capture the batch sizes we benchmark, skip the vision tower.
--max-num-seqs
16
--max-cudagraph-capture-size
16
--language-model-only
--profiler-config
{"profiler":"torch","torch_profiler_dir":"/root/.cache/profiles","ignore_frontend":true,"torch_profiler_with_stack":false,"torch_profiler_use_gzip":true}
